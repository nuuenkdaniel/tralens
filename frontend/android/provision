#!/usr/bin/env bash
# Seed an independent build workspace from the unpacked productivity-app tools.
set -euo pipefail
repo=$(cd -- "$(dirname -- "$0")/../.." && pwd -P)
seed=${1:-"$repo/../productivity_app/.android-build"}
target="$repo/.android-build"
if [[ -e "$target" || -L "$target" ]]; then
  echo "Already present: $target. Provisioning only creates a new workspace." >&2
  exit 1
fi
shopt -s nullglob
distributions=("$seed"/gradle/wrapper/dists/gradle-8.11.1-bin/*/gradle-8.11.1)
[[ ${#distributions[@]} == 1 ]] || { echo "Expected one Gradle 8.11.1 distribution under $seed" >&2; exit 1; }
node=$(type -P node)
npm_cli=$(realpath -- "$(type -P npm)")
npm_package=$(dirname -- "$(dirname -- "$npm_cli")")
[[ -f "$npm_package/bin/npm-cli.js" ]] || { echo "Cannot locate the installed npm package" >&2; exit 1; }
umask 077
mkdir -- "$target"
# Only remove a partial workspace created by this invocation.
trap 'rm -rf -- "$target"' EXIT
mkdir -p "$target"/{sdk,bin,work,home,tmp,gradle,android-user,cache}
copy_tool() {
  mkdir -p -- "$(dirname -- "$2")"
  cp -a --reflink=auto -- "$1" "$2"
}
copy_tool "$seed/java" "$target/java"
copy_tool "${distributions[0]}" "$target/gradle-dist"
for component in platforms/android-35 build-tools/35.0.0 platform-tools cmdline-tools/latest licenses; do
  copy_tool "$seed/sdk/$component" "$target/sdk/$component"
done
copy_tool "$(realpath -- "$node")" "$target/bin/node"
copy_tool "$npm_package" "$target/npm"
# Arch packages these npm dependencies as siblings of npm itself.
for package in node-gyp nopt semver; do
  if [[ ! -d "$target/npm/node_modules/$package" ]]; then
    copy_tool "$(dirname -- "$npm_package")/$package" "$target/npm/node_modules/$package"
  fi
done
ln -s ../npm/bin/npm-cli.js "$target/bin/npm"
# External symlinks would leave the workspace dependent on the seed.
while IFS= read -r -d '' link; do
  resolved=$(realpath -m -- "$link")
  [[ "$resolved" == "$target/"* ]] || { echo "External tool symlink: $link" >&2; exit 1; }
done < <(find "$target" -type l -print0)
"$repo/frontend/android/android-env" npm --version >/dev/null
trap - EXIT
echo "Android workspace ready: $target"
