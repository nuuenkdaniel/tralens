# Default image for the public beta. Pin a version tag or digest for upgrades.
# TRALENS_IMAGE=ghcr.io/nuuenkdaniel/tralens:v0.1.0-beta.1
# These must match the owner of the data directories (id -u / id -g).
# TRALENS_UID=1000
# TRALENS_GID=1000

# Local browser or SSH tunnel by default. Set the exact HTTPS origin to
# enable owner login behind a reverse proxy, then create config/owner.key.
# TRALENS_ORIGIN=https://manga.example.com
# TRALENS_PORT=7871

# Ollama must already be running at this address with this model installed.
# TRALENS_OLLAMA=http://127.0.0.1:11434
# TRALENS_MODEL=translategemma:4b
# TRALENS_MODEL_PROFILE=translategemma
# TRALENS_FRONTIER_PROVIDER=disabled

# Relative paths are resolved alongside compose.yml.
# TRALENS_LIBRARY=./tralens-data/library
# TRALENS_CONFIG=./tralens-data/config
# TRALENS_STATE=./tralens-data/state
# TRALENS_MODELS=./tralens-data/models
# TRALENS_ASSETS=./tralens-data/assets
# TRALENS_FONTS=/assets/fonts.json
