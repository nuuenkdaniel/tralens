# Source builds default to tralens:local. Release bundles set an exact digest.
# TRALENS_IMAGE=tralens:local
# These must match the owner of the data directories (id -u / id -g).
# TRALENS_UID=1000
# TRALENS_GID=1000

# Local browser or SSH tunnel by default. Set the exact HTTPS origin to
# serve the reader behind a reverse proxy, then create config/owner.key.
# TRALENS_ORIGIN=https://manga.example.com
# TRALENS_PORT=7871
# TRALENS_REGISTRATION=closed  # default: open

# The optional ollama profile binds only to loopback. For an existing Ollama
# service, set its private origin instead. Install the specified model once.
# TRALENS_OLLAMA_PORT=11434
# TRALENS_OLLAMA_DATA=./tralens-data/ollama
# TRALENS_OLLAMA=http://127.0.0.1:11434
# TRALENS_MODEL=translategemma:12b
# TRALENS_MODEL_PROFILE=translategemma
# TRALENS_FRONTIER_PROVIDER=disabled

# Relative paths are resolved alongside compose.yml.
# TRALENS_LIBRARY=./tralens-data/library
# TRALENS_CONFIG=./tralens-data/config
# TRALENS_STATE=./tralens-data/state
# To use external OCR exports instead of the ones bundled in the image:
# TRALENS_OCR_ROOT=/models
# TRALENS_MODELS=./tralens-data/models
# TRALENS_ASSETS=./tralens-data/assets
# TRALENS_FONTS=/assets/fonts.json
